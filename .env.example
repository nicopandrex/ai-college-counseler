# Copy this file to .env (same folder) and put your Gemini API key below.
LLM_API_KEY=paste-your-gemini-key-here
LLM_PROVIDER=gemini
LLM_CACHE_MODE=record
LLM_CACHE_DIR=fixtures/private/llm-cache
LLM_MAX_LIVE_CALLS=30
# Chat replies are reworded by the LLM, and shown only if they keep the system's facts
# (same courses, numbers, times, instructors). 0 = always show the plain templates.
PLANNER_REWORD=1
